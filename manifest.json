{
  "name": "Venda do Terreno – Recebíveis",
  "short_name": "Venda Terreno",
  "description": "Controle das parcelas e comprovantes da venda do terreno (Ibirité/MG).",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#E30613",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "icons/icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./receber-backup",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "backup",
          "accept": [
            "text/plain",
            ".txt",
            "application/json",
            ".json",
            "application/octet-stream",
            "*/*"
          ]
        }
      ]
    }
  }
}